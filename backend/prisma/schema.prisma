generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EmployeeStatus {
  active
  inactive
}

model Employees {
  id            String         @id @default(uuid()) @db.Uuid
  employee_code String         @db.VarChar(20)
  full_name     String         @db.VarChar(100)
  display_name  String?        @db.VarChar(100)
  email         String         @unique @db.VarChar(100)
  phone         String?        @db.VarChar(20)
  identify_card String         @unique @db.VarChar(20)
  gender        String?        @db.VarChar(10)
  date_of_birth DateTime?      @db.Date
  avatar_url    String?        @db.Text
  hire_date     DateTime       @db.Date
  status        EmployeeStatus @default(active)

  department_id String      @db.Uuid
  department    Departments @relation(fields: [department_id], references: [id])

  position_id String    @db.Uuid
  position    Positions @relation(fields: [position_id], references: [id])

  roles EmployeeRoles[]

  created_at DateTime @default(now())

  @@map("employees")
}

model Roles {
  id        String @id @default(uuid()) @db.Uuid
  role_name String @db.VarChar(50)

  employees EmployeeRoles[]

  @@map("roles")
}

model EmployeeRoles {
  id      String @id @default(uuid()) @db.Uuid
  user_id String @db.Uuid
  role_id String @db.Uuid

  employee Employees @relation(fields: [user_id], references: [id])
  role     Roles     @relation(fields: [role_id], references: [id])

  @@map("employee_roles")
}

model Departments {
  id              String  @id @default(uuid()) @db.Uuid
  department_code String  @db.VarChar(100)
  department_name String  @db.VarChar(100)
  description     String?

  employees Employees[]
  positions Positions[]

  @@map("departments")
}

model Positions {
  id            String  @id @default(uuid()) @db.Uuid
  position_name String  @db.VarChar(100)
  level         String  @db.VarChar(100)
  description   String?

  department_id String      @db.Uuid
  department    Departments @relation(fields: [department_id], references: [id])

  employees Employees[]

  @@map("positions")
}
