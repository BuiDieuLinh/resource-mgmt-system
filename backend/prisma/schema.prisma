// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmployeeStatus {
  active
  inactive
}

model Employees {
  id            String         @id @default(uuid()) @db.Uuid
  employee_code String         @db.VarChar(20)
  full_name     String         @db.VarChar(100)
  display_name  String?        @db.VarChar(100)
  email         String         @unique @db.VarChar(100)
  phone         String         @db.VarChar(20)
  identify_card String         @unique @db.VarChar(20)
  gender        String         @db.VarChar(10)
  date_of_birth DateTime       @db.Date
  address       String         @db.Text
  avatar_url    String?        @db.Text
  hire_date     DateTime       @db.Date
  status        EmployeeStatus @default(active)

  position_id String    @db.Uuid
  created_at  DateTime  @default(now())
  position    Positions @relation(fields: [position_id], references: [id])

  roles          EmployeeRoles[]
  work_schedules EmployeeWorkSchedules[]
  attendances    Attendances[]
  leave_requests LeaveRequests[]

  @@map("employees")
}

model Roles {
  id        String @id @default(uuid()) @db.Uuid
  role_name String @db.VarChar(50)

  employees EmployeeRoles[]

  @@map("roles")
}

model EmployeeRoles {
  id      String @id @default(uuid()) @db.Uuid
  user_id String @db.Uuid
  role_id String @db.Uuid

  employee Employees @relation(fields: [user_id], references: [id])
  role     Roles     @relation(fields: [role_id], references: [id])

  @@map("employee_roles")
}

model Departments {
  id              String      @id @default(uuid()) @db.Uuid
  department_code String      @db.VarChar(100)
  department_name String      @db.VarChar(100)
  description     String?
  positions       Positions[]

  @@map("departments")
}

enum PositionLevel {
  junior
  mid
  senior
  lead
  manager
}

model Positions {
  id            String        @id @default(uuid()) @db.Uuid
  position_name String        @db.VarChar(100)
  level         PositionLevel
  description   String?

  department_id String      @db.Uuid
  department    Departments @relation(fields: [department_id], references: [id])

  employees Employees[]

  @@map("positions")
}

model WorkPolicies {
  id String @id @default(uuid()) @db.Uuid

  is_flexible_enabled    Boolean @default(false)
  flexible_start Int?   
  flexible_end   Int?   

  break_start Int?
  break_end   Int?

  effective_from DateTime
  effective_to   DateTime?

  created_at DateTime @default(now())

  @@index([effective_from, effective_to])
  @@map("work_policies")
}

model EmployeeWorkSchedules {
  id           String @id @default(uuid()) @db.Uuid
  employee_id  String @db.Uuid
  day_of_week  Int                    
  start_time   Int                    
  end_time     Int                    

  employee Employees @relation(fields: [employee_id], references: [id])

  @@map("employee_work_schedules")
}

enum AttendanceStatus {
  approved
  pending
  rejected
  on_leave
  absent
}

model Attendances {
  id              String   @id @default(uuid()) @db.Uuid
  employee_id     String   @db.Uuid
  work_date       DateTime @db.Date
  scheduled_start Int
  scheduled_end   Int

  break_start Int?
  break_end   Int?

  flexible_start Int?  
  flexible_end   Int?  

  check_in_time  DateTime? @db.Timestamptz
  check_out_time DateTime? @db.Timestamptz

  late         Int @default(0)
  early_leave  Int @default(0)
  overtime     Int @default(0)
  work_minutes Int @default(0)

  status     AttendanceStatus @default(pending)
  created_at DateTime         @default(now())

  employee Employees        @relation(fields: [employee_id], references: [id])
  logs     AttendanceLogs[]

  @@unique([employee_id, work_date])
  @@map("attendances")
}

enum AttendanceAction {
  check_in
  check_out
}

model AttendanceLogs {
  id            String           @id @default(uuid()) @db.Uuid
  attendance_id String           @db.Uuid
  action        AttendanceAction
  timestamp     DateTime         @db.Timestamptz
  latitude      Decimal?         @db.Decimal(10, 6)
  longitude     Decimal?         @db.Decimal(10, 6)
  ip_address    String?          @db.VarChar(50)
  user_agent    String?

  attendance Attendances @relation(fields: [attendance_id], references: [id])

  @@index([attendance_id])
  @@map("attendance_logs")
}

model Holidays {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(100)
  holiday_date DateTime @db.Date
  description  String?
  is_paid      Boolean  @default(true)

  @@unique([holiday_date])
  @@map("holidays")
}

enum LeaveType {
  annual
  sick
  maternity
  paternity
  unpaid
}

enum LeaveStatus {
  pending
  approved
  rejected
}

model LeaveRequests {
  id                  String      @id @default(uuid()) @db.Uuid
  employee_id         String      @db.Uuid
  leave_type          LeaveType
  start_date          DateTime    @db.Date
  end_date            DateTime    @db.Date
  leave_start_minutes Int?
  leave_end_minutes   Int?
  reason              String?
  status              LeaveStatus @default(pending)
  approved_by_manager String?     @db.Uuid
  manager_approved_at DateTime?   @db.Timestamptz
  approved_by_admin   String?     @db.Uuid
  admin_approved_at   DateTime?   @db.Timestamptz
  created_at          DateTime    @default(now())

  employee Employees @relation(fields: [employee_id], references: [id])

  @@index([employee_id, start_date, end_date])
  @@map("leave_requests")
}
